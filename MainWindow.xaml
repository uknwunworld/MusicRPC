<Window x:Class="MusicRPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicRPC" Width="960" Height="660" MinWidth="900" MinHeight="620"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" Icon="app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,12,0,0"
                   HorizontalAlignment="Right" Text="1.0.0 ver"/>

        <!-- ===== Верхняя панель ===== -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="app-icon.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MusicRPC" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Text="by murphydev"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="21" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Tab}" GroupName="nav" Content="Обзор" IsChecked="True" Tag="0" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Tab}" GroupName="nav" Content="Активность" Tag="1" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Tab}" GroupName="nav" Content="Источники" Tag="2" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Tab}" GroupName="nav" Content="Настройки" Tag="3" Checked="Nav_Checked"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="19" Padding="14,7,6,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DiscordDot" Width="9" Height="9" Fill="{DynamicResource Bad}" Margin="0,0,9,0"/>
                    <TextBlock x:Name="DiscordStatus" FontSize="12.5" MaxWidth="190" VerticalAlignment="Center" Text="Не подключено"/>
                    <Button Style="{StaticResource Btn}" Margin="10,0,0,0" Padding="10,3" Content="⟳" ToolTip="Переподключить" Click="Reconnect_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Страницы ===== -->
        <Grid Grid.Row="1">

            <!-- 0: Обзор -->
            <Grid x:Name="Page0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource HeroGrad}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="176" Height="176" CornerRadius="8" Background="{DynamicResource CoverBg}" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="CoverNote" Text="♪" FontSize="64" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="CoverImg" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NpHeader" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="СЕЙЧАС В ПЛЕЕРЕ"/>
                            <TextBlock x:Name="NpTitle" Style="{StaticResource H1}" Margin="0,8,0,0" Text="Музыка ещё не играет"/>
                            <TextBlock x:Name="NpArtist" Foreground="{DynamicResource Muted}" FontSize="15" Margin="0,4,0,0" Text="Откройте плеер и включите трек"/>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NpPos" Style="{StaticResource MutedText}" Text="00:00"/>
                                <ProgressBar x:Name="NpBar" Grid.Column="1" Style="{StaticResource Bar}" Margin="12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NpDur" Grid.Column="2" Style="{StaticResource MutedText}" Text="--:--"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="NpStatus" FontSize="12" Text="Ожидание воспроизведения"/></Border>
                                <Border x:Name="NpMetaBox" Style="{StaticResource Chip}" Visibility="Collapsed"><TextBlock x:Name="NpMeta" FontSize="12"/></Border>
                                <TextBlock x:Name="NpLinkBox" VerticalAlignment="Center" Visibility="Collapsed" FontSize="12">
                                    <Hyperlink x:Name="NpLink" Foreground="{DynamicResource Accent}" Click="TrackLink_Click">Открыть трек ↗</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,26,0,12">
                    <TextBlock Style="{StaticResource H2}" Text="Поиск обложки"/>
                    <TextBlock x:Name="SearchCount" Style="{StaticResource MutedText}" HorizontalAlignment="Right" Text="3 источника"/>
                </Grid>

                <Grid Grid.Row="2" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBox}" Padding="18,14">
                        <StackPanel><TextBlock Text="Яндекс Музыка" FontWeight="SemiBold" FontSize="13.5"/><TextBlock x:Name="StYandex" FontSize="12.5" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="18,14">
                        <StackPanel><TextBlock Text="iTunes" FontWeight="SemiBold" FontSize="13.5"/><TextBlock x:Name="StITunes" FontSize="12.5" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardBox}" Padding="18,14">
                        <StackPanel><TextBlock Text="Deezer" FontWeight="SemiBold" FontSize="13.5"/><TextBlock x:Name="StDeezer" FontSize="12.5" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 1: Активность -->
            <Grid x:Name="Page1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Активность"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18" Text="Так статус выглядит в Discord"/>
                    <Border Background="{DynamicResource Preview}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="PvHeader" FontWeight="SemiBold" FontSize="12.5" Text="Слушает …"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="6" Background="{DynamicResource CoverBg}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="PvNote" Text="♪" FontSize="30" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="PvImg" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PvTitle" FontWeight="SemiBold" FontSize="14" Text="—"/>
                                    <TextBlock x:Name="PvArtist" Style="{StaticResource MutedText}" Text="—"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PvPos" Style="{StaticResource MutedText}" FontSize="11" Text="00:00"/>
                                        <ProgressBar x:Name="PvBar" Grid.Column="1" Style="{StaticResource Bar}" Height="4" Margin="8,0"/>
                                        <TextBlock x:Name="PvDur" Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11" Text="--:--"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource H1}" Text="Параметры"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18" Text="Что показывать в статусе"/>
                <Border Style="{StaticResource CardBox}" VerticalAlignment="Top">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" Tag="ShowCover">
                            <StackPanel><TextBlock Text="Обложка" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Ищется автоматически в Яндекс Музыке, iTunes и Deezer"/></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" Tag="ShowProgress">
                            <StackPanel><TextBlock Text="Прогресс" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Полоса времени трека в статусе"/></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" Tag="ShowButtons">
                            <StackPanel><TextBlock Text="Кнопка «Открыть трек»" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Ссылка на найденный трек"/></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" Tag="NameAsTrack">
                            <StackPanel><TextBlock Text="«Слушает Артист — Трек»" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Выключено — будет название приложения"/></StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" Tag="ShowPaused" Margin="0">
                            <StackPanel><TextBlock Text="Показывать на паузе" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Иначе статус скрывается, пока музыка стоит"/></StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- 2: Источники -->
            <Grid x:Name="Page2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Источники"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18" Text="Откуда брать трек (медиа-сессии Windows)"/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" Tag="UseSpotify">
                                <StackPanel><TextBlock Text="Spotify" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Десктопное приложение"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="UseYandex">
                                <StackPanel><TextBlock Text="Яндекс Музыка" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Приложение и веб-версия"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="UseSoundCloud">
                                <StackPanel><TextBlock Text="SoundCloud" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="В браузере (Chrome, Edge, Firefox, Opera…)"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="UseOtherBrowser">
                                <StackPanel><TextBlock Text="Другие сайты в браузере" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="YouTube и прочее"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="UseOtherPlayers" Margin="0">
                                <StackPanel><TextBlock Text="Другие плееры" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Любое приложение с медиа-сессией"/></StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource H1}" Text="Сессии"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18" Text="Что сейчас видит Windows"/>
                    <Border Style="{StaticResource CardBox}" Padding="18">
                        <StackPanel>
                            <ItemsControl x:Name="SessionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap" TextTrimming="None"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoSessions" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextTrimming="None" Text="Сейчас ни один плеер не сообщает о воспроизведении"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3: Настройки -->
            <Grid x:Name="Page3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Настройки"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18" Text="Поведение программы"/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" Tag="LightTheme">
                                <StackPanel><TextBlock Text="Светлая тема" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Светлое оформление окна"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="Autostart">
                                <StackPanel><TextBlock Text="Запускать с Windows" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Сворачивается в трей"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="StartMinimized">
                                <StackPanel><TextBlock Text="Запускать свёрнутым" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Без открытия окна"/></StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="CloseToTray" Margin="0">
                                <StackPanel><TextBlock Text="Закрытие сворачивает в трей" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Выход — в меню иконки в трее"/></StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource H1}" Text="Обложки"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,18" Text="Где искать обложку трека"/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" Tag="SearchYandex"><TextBlock Text="Яндекс Музыка" FontWeight="SemiBold"/></CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="SearchITunes"><TextBlock Text="iTunes" FontWeight="SemiBold"/></CheckBox>
                            <CheckBox Style="{StaticResource Switch}" Tag="SearchDeezer" Margin="0"><TextBlock Text="Deezer" FontWeight="SemiBold"/></CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
